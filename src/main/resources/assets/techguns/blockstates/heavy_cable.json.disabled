{
  "multipart": [
    {
      "apply": {
        "model": "techguns:block/heavy_cable_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "techguns:block/heavy_cable_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "techguns:block/heavy_cable_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "techguns:block/heavy_cable_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "techguns:block/heavy_cable_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "techguns:block/heavy_cable_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "techguns:block/heavy_cable_arm",
        "x": 90
      }
    }
  ]
}